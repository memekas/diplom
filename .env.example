# Copy to .env and fill in. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Prisma / SQLite database file
DATABASE_URL="file:./dev.db"

# Better Auth — session signing secret + base URL
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Admin seed account (consumed by prisma/seed.ts — plan 02)
ADMIN_EMAIL="admin@padel.local"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
