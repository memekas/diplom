@startuml architecture
title Архитектура веб-приложения для проведения турниров

skinparam componentStyle uml2
skinparam shadowing false
left to right direction

actor "Пользователь\n/ Администратор" as User

package "Браузер" {
  [Клиентские формы\n(React)] as Forms
}

package "Next.js (сервер, App Router)" {
  package "Слой представления" {
    [Серверные компоненты\n(чтение)] as RSC
  }
  package "Слой действий" {
    [Серверные действия\n(запись)] as Actions
  }
  package "Авторизация" {
    [Проверка прав\n(пользователь / админ)] as Auth
    [Better Auth\n(сессия, cookie)] as BetterAuth
  }
  package "Валидация" {
    [Zod-схемы\n(валидация ввода)] as Zod
  }
  package "Сервисный слой" {
    [Турниры / регистрация] as Svc1
    [Сетка / движок форматов\n/ результат] as Svc2
  }
  [Клиент Prisma] as Prisma
}

database "SQLite\n(dev.db)" as DB

User --> Forms
User --> RSC : запрос страницы
Forms --> Actions : отправка формы
RSC --> Svc1 : чтение
Actions --> Auth : проверка прав
Auth --> BetterAuth
Actions --> Zod : валидация ввода
Actions --> Svc1 : вызов
Actions --> Svc2 : вызов
Svc1 --> Prisma
Svc2 --> Prisma
Prisma --> DB

@enduml
