%% Рисунок 1. Существующий (ручной) процесс организации турнира в ООО «Падел-Про» (as-is)
%% BPMN-приближение в Mermaid. Строгий вариант — 01-bpmn-process.bpmn (bpmn.io).
flowchart TD
    start((Принято решение<br/>провести турнир)) --> params[Определить параметры турнира:<br/>дата, формат, уровень, лимит, цена]
    params --> publish[Опубликовать анонс вручную в нескольких<br/>разрозненных каналах: сайт, чат, форма, ЛС]

    publish --> learn[Игрок: узнать о турнире<br/>из одного из каналов]
    learn --> apply[Игрок: подать заявку через<br/>доступный канал — уровень, партнёр]

    apply --> collect[Собрать заявки из разных<br/>каналов вручную]
    collect --> transfer[Перенести данные в таблицу<br/>или заметки вручную]
    transfer --> check[Проверить заявку:<br/>уровень, полнота, дубли]

    check --> gValid{Заявка<br/>корректна?}
    gValid -- нет --> clarify[Игрок: уточнить / дослать данные]
    clarify --> check
    gValid -- да --> register[Зафиксировать участника / пару<br/>в списке вручную]

    register --> gReg{Регистрация<br/>закрыта?}
    gReg -- нет --> collect
    gReg -- да --> makeMatches[Сформировать пары / матчи /<br/>турнирную сетку вручную]

    makeMatches --> schedule[Опубликовать расписание матчей]
    schedule --> play[Игроки участвуют в матчах]
    play --> getRes[Собрать результаты матчей<br/>от игроков вручную]
    getRes --> recRes[Внести результаты в таблицу<br/>или заметки вручную]

    recRes --> gAll{Все матчи<br/>сыграны?}
    gAll -- нет --> nextMatches[Сформировать следующие<br/>матчи вручную]
    nextMatches --> schedule
    gAll -- да --> summarize[Подвести итоги турнира]

    summarize --> publishRes[Опубликовать итоговые результаты]
    publishRes --> done((Турнир завершён))
