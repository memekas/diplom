<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_AsIs"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_AsIs" name="ООО «Падел-Про» — текущий процесс организации турнира" processRef="Process_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Admin" name="Администратор">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Params</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_All</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Summary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Player" name="Игрок">
        <bpmn:flowNodeRef>T_Learn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Play</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Принято решение провести турнир">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="T_Params" name="Определить параметры турнира">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Publish" name="Опубликовать анонс в нескольких каналах">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Learn" name="Узнать о турнире">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Apply" name="Подать заявку через доступный канал">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Collect" name="Собрать заявки и внести в таблицу">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_RegNo</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Check" name="Проверить и зафиксировать участников">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Reg" name="Регистрация закрыта?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_RegYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RegNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Schedule" name="Сформировать матчи и опубликовать расписание">
      <bpmn:incoming>Flow_RegYes</bpmn:incoming>
      <bpmn:incoming>Flow_AllNo</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Play" name="Участвовать в матчах">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Results" name="Собрать и внести результаты">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_All" name="Все матчи сыграны?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_AllYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AllNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Summary" name="Подвести и опубликовать итоги">
      <bpmn:incoming>Flow_AllYes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="EndEvent_1" name="Турнир завершён">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="T_Params" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="T_Params" targetRef="T_Publish" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="T_Publish" targetRef="T_Learn" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="T_Learn" targetRef="T_Apply" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="T_Apply" targetRef="T_Collect" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="T_Collect" targetRef="T_Check" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="T_Check" targetRef="Gw_Reg" />
    <bpmn:sequenceFlow id="Flow_RegYes" name="да" sourceRef="Gw_Reg" targetRef="T_Schedule" />
    <bpmn:sequenceFlow id="Flow_RegNo" name="нет" sourceRef="Gw_Reg" targetRef="T_Collect" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="T_Schedule" targetRef="T_Play" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="T_Play" targetRef="T_Results" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="T_Results" targetRef="Gw_All" />
    <bpmn:sequenceFlow id="Flow_AllYes" name="да" sourceRef="Gw_All" targetRef="T_Summary" />
    <bpmn:sequenceFlow id="Flow_AllNo" name="нет" sourceRef="Gw_All" targetRef="T_Schedule" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T_Summary" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_AsIs_di" bpmnElement="Participant_AsIs" isHorizontal="false">
        <dc:Bounds x="160" y="80" width="990" height="900" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="false">
        <dc:Bounds x="160" y="110" width="670" height="870" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Player_di" bpmnElement="Lane_Player" isHorizontal="false">
        <dc:Bounds x="830" y="110" width="320" height="870" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="582" y="150" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="648" y="151" width="130" height="34" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Params_di" bpmnElement="T_Params">
        <dc:Bounds x="410" y="210" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Publish_di" bpmnElement="T_Publish">
        <dc:Bounds x="410" y="285" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Collect_di" bpmnElement="T_Collect">
        <dc:Bounds x="410" y="360" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Check_di" bpmnElement="T_Check">
        <dc:Bounds x="410" y="435" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Reg_di" bpmnElement="Gw_Reg" isMarkerVisible="true">
        <dc:Bounds x="575" y="510" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="630" y="512" width="110" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Schedule_di" bpmnElement="T_Schedule">
        <dc:Bounds x="410" y="585" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Results_di" bpmnElement="T_Results">
        <dc:Bounds x="410" y="660" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_All_di" bpmnElement="Gw_All" isMarkerVisible="true">
        <dc:Bounds x="575" y="735" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="630" y="737" width="105" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Summary_di" bpmnElement="T_Summary">
        <dc:Bounds x="410" y="810" width="380" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="582" y="892" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="562" y="932" width="76" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="T_Learn_di" bpmnElement="T_Learn">
        <dc:Bounds x="845" y="285" width="290" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Apply_di" bpmnElement="T_Apply">
        <dc:Bounds x="845" y="360" width="290" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Play_di" bpmnElement="T_Play">
        <dc:Bounds x="845" y="660" width="290" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="600" y="186" /><di:waypoint x="600" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="600" y="260" /><di:waypoint x="600" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="790" y="310" /><di:waypoint x="845" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="990" y="335" /><di:waypoint x="990" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="845" y="385" /><di:waypoint x="790" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="600" y="410" /><di:waypoint x="600" y="435" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="600" y="485" /><di:waypoint x="600" y="510" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RegYes_di" bpmnElement="Flow_RegYes">
        <di:waypoint x="600" y="560" /><di:waypoint x="600" y="585" />
        <bpmndi:BPMNLabel><dc:Bounds x="608" y="565" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RegNo_di" bpmnElement="Flow_RegNo">
        <di:waypoint x="575" y="535" /><di:waypoint x="300" y="535" /><di:waypoint x="300" y="385" /><di:waypoint x="410" y="385" />
        <bpmndi:BPMNLabel><dc:Bounds x="545" y="518" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="790" y="610" /><di:waypoint x="990" y="610" /><di:waypoint x="990" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="845" y="685" /><di:waypoint x="790" y="685" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="600" y="710" /><di:waypoint x="600" y="735" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AllYes_di" bpmnElement="Flow_AllYes">
        <di:waypoint x="600" y="785" /><di:waypoint x="600" y="810" />
        <bpmndi:BPMNLabel><dc:Bounds x="608" y="790" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AllNo_di" bpmnElement="Flow_AllNo">
        <di:waypoint x="575" y="760" /><di:waypoint x="300" y="760" /><di:waypoint x="300" y="610" /><di:waypoint x="410" y="610" />
        <bpmndi:BPMNLabel><dc:Bounds x="545" y="743" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="600" y="860" /><di:waypoint x="600" y="892" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
