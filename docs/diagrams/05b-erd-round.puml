@startuml erd-round
title Инфологическая модель — подсистема круговых форматов (одиночные)

hide circle
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 110

entity "Пользователь" as User {
  * id
  --
  имя
  ник
  уровень
}

entity "Турнир" as Tournament {
  * id
  --
  название
  формат
  режим участия
}

entity "Участник" as TPlayer {
  * id
}

entity "Раунд" as Round {
  * id
  --
  номер раунда
  статус
}

entity "Матч раунда" as RoundMatch {
  * id
  --
  номер корта
  очки А / Б
}

entity "Очки игрока" as PMS {
  * id
  --
  сторона (А / Б)
  очки за / против
}

Tournament ||--o{ TPlayer
Tournament ||--o{ Round
User ||--o{ TPlayer
Round ||--o{ RoundMatch
RoundMatch ||--o{ PMS
User ||--o{ PMS

@enduml
