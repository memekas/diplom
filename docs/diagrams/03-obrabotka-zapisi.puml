@startuml seq-write
title Обработка пользовательского действия (запись результата)

actor "Администратор" as Admin
participant "Форма\n(клиент)" as Form
participant "Серверное действие\n(запись результата)" as Action
participant "Проверка прав\n(требуется админ)" as Auth
participant "Валидация (Zod)\n(разбор формы счёта)" as Zod
participant "Сервис\n(движок форматов / результат)" as Svc
participant "Клиент Prisma" as Prisma
database "SQLite" as DB

Admin -> Form : ввод счёта, отправка
Form -> Action : отправка формы (POST)

Action -> Auth : проверка прав
alt не администратор / гость
  Auth --> Action : исключение «Доступ запрещён»
  Action --> Form : (ошибка прав)
end
Auth --> Action : личность из сессии

Action -> Zod : разбор и проверка счёта
alt некорректно
  Zod --> Action : отказ
  Action --> Form : ошибка
end
Zod --> Action : успех (данные)

Action -> Svc : запись результата (по формату)
Svc -> Prisma : запись результата
Prisma -> DB : вставка / обновление
DB --> Prisma : успешно
Prisma --> Svc : результат
Svc --> Action : результат

Action -> Action : обновление страницы
Action --> Form : успех
Form --> Admin : обновлённая страница

@enduml
