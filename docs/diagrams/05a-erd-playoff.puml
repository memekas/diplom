@startuml erd-playoff
title Инфологическая модель — подсистема плей-офф (пары)

hide circle
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 110

entity "Пользователь" as User {
  * id
  --
  имя
  ник
  роль (игрок / админ)
  уровень
}

entity "Турнир" as Tournament {
  * id
  --
  название
  размер (4/8/16)
  статус
  формат
}

entity "Пара" as Pair {
  * id
  --
  посев
}

entity "Матч плей-офф" as Match {
  * id
  --
  раунд
  позиция
  победитель
}

entity "Счёт сета" as SetScore {
  * id
  --
  номер сета
  геймы пары А / Б
}

User ||--o{ Pair
Pair ||--o{ Match
Tournament ||--o{ Pair
Tournament ||--o{ Match
Match ||--o{ SetScore

@enduml
